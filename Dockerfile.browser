# Browser (wasm32-unknown-emscripten) build. emsdk must be 4.x or newer for the wasm features
# rustc's prebuilt std emits, and has no ABI promises, so a bump needs an in-browser retest.
ARG EMSDK_VERSION=6.0.7
FROM emscripten/emsdk:${EMSDK_VERSION}

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable \
    && ~/.cargo/bin/rustup target add wasm32-unknown-emscripten
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app
COPY . .

# SDL2 comes from -sUSE_SDL=2 in .cargo/config.toml, so no pkgconfig or vcpkg
RUN cargo build --release -p dr-rustario-vs-rustris \
      --target wasm32-unknown-emscripten --no-default-features --features browser
